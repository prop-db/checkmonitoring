generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations take Postgres advisory locks, which Neon's pooled (PgBouncer)
  // endpoint does not support. `directUrl` is the same connection string with
  // "-pooler" removed, and is used by Prisma Migrate only.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  FINANCE_USER
  FINANCE_ADMIN
}

enum CheckStatus {
  GENERATED
  SIGNATURE_PENDING
  SIGNED
  READY_FOR_RELEASE
  SCHEDULED
  RELEASED
  CANCELLED
  VOIDED
}

enum AcumaticaTenant {
  GOLIVE
  MANUFACTURING
}

enum ClearingStatus {
  NONE
  DEPOSITED
  ENCASHED
  CLEARED
}

enum Eligibility {
  SUPPLIER
  BROKER
  INTERNAL
}

enum PortalDomain {
  LOCAL
  BROKER
}

enum PortalSyncStatus {
  NOT_APPLICABLE
  PENDING
  SYNCED
  FAILED
}

enum ActorType {
  SYSTEM
  USER
}

enum PortalDirection {
  OUT
  IN
}

enum PortalEventStatus {
  PENDING
  IN_FLIGHT
  SYNCED
  FAILED
  // Terminal and deliberate: delivery was abandoned and a human must look.
  // Distinct from FAILED, which is retryable.
  PARKED
}

// What an event instructs the portal to do. Deliberately NOT the same set as
// `PortalSyncStatus`, which is a cheque's state; this is one message about it.
enum PortalEventKind {
  MARK_AVAILABLE
  REVERT
  // The third call site. `markReleased` in lib/domain/actions.ts already queues
  // this and a test pins it. It IS deliverable: the portal's POST /api/checks/:id
  // accepts `status`, `orNumber` and `orDate` at encoder tier. Plan 3's first
  // draft omitted it because it was written against two of the three
  // portalEvent.create sites that actually exist. Do not remove it.
  RELEASED
}

model Company {
  id           String           @id @default(cuid())
  code         String           @unique   // STK, A1+, P&P
  name         String
  tenant       AcumaticaTenant?
  branch       String?
  legalNames   String[]                   // used by eligibility to detect inter-company
  cashAccounts CashAccount[]
  checkBooks   CheckBook[]
  checks       Check[]
  createdAt    DateTime         @default(now())

  @@unique([tenant, branch])
}

model Bank {
  id           String        @id @default(cuid())
  code         String        @unique   // BPI, MBTC, BDO
  name         String
  cashAccounts CashAccount[]
  checkBooks   CheckBook[]
}

model CashAccount {
  id        String  @id @default(cuid())
  code      String  @unique            // "BPI STK"
  bankId    String
  companyId String
  bank      Bank    @relation(fields: [bankId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  checks    Check[]
}

model CheckBook {
  id        String  @id @default(cuid())
  code      String  @unique            // "BPI-S-4636"
  bankId    String
  companyId String
  bank      Bank    @relation(fields: [bankId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  checks    Check[]
}

model Vendor {
  id                  String       @id @default(cuid())
  vendorId            String?      @unique
  canonicalName       String       @unique
  aliases             String[]
  eligibilityDefault  Eligibility?
  checks              Check[]
}

// @@check "check_internal_never_routes_to_portal" (migration
// 20260901140000_internal_never_routes_to_portal): Prisma does not manage
// CHECK constraints, so this comment is the record of one that exists only
// in the database. It enforces that an INTERNAL check can never carry portal
// routing state:
//   eligibility <> 'INTERNAL'
//   OR (portalDomain IS NULL AND portalSyncStatus = 'NOT_APPLICABLE')
model Check {
  id                 String           @id @default(cuid())
  acumaticaPaymentId String?          @unique

  checkNumber        String
  cvNumber           String?
  checkDate          DateTime?
  // Nullable because the register genuinely does not always know them: of its
  // 12,161 parsed rows, 397 carry no amount (260 blank, 135 where the amount
  // column holds the word "CANCELLED", 2 shifted rows holding a date) and 153
  // carry no payee. NULL means "not recorded" - it is not a synonym for 0.00 or
  // for ''. Storing 0.00 would understate every per-currency total the cheque
  // appears in and would be indistinguishable from a real zero-value cheque;
  // storing '' would read as a cheque payable to nobody. The domain has modelled
  // both as nullable since Plan 1 (ReadyGuardInput, REQUIRED_FIELDS), so
  // checkReadyForRelease already blocks release until someone fills the gap in,
  // and classifyEligibility already answers INTERNAL for an absent payee - which
  // is what keeps such a cheque off the supplier portal. Do not "tidy" these
  // back to NOT NULL with a default.
  amount             Decimal?         @db.Decimal(18, 2)
  currency           String           @default("PHP")

  // Not every Acumatica payment is a cheque. The China offices pay by transfer,
  // and their PaymentRef carries an AP reference rather than a cheque number.
  // Such a payment is tracked but has no physical document to sign or hand over.
  isCheque           Boolean          @default(true)

  companyId          String
  cashAccountId      String?
  checkBookId        String?
  vendorId           String?
  payeeName          String?          // see the note on `amount` above

  category           String?
  eligibility        Eligibility
  eligibilityOverriddenById String?

  portalTradeId      Int?
  portalDomain       PortalDomain?
  portalSyncStatus   PortalSyncStatus @default(NOT_APPLICABLE)

  status             CheckStatus      @default(GENERATED)

  signedById            String?
  signedAt              DateTime?
  readyById             String?
  readyAt               DateTime?
  availablePickupDate   DateTime?

  scheduledPickupDate   DateTime?
  scheduledPickupTime   String?
  pickupRep             String?
  portalConfirmedAt     DateTime?

  releasedById       String?
  releasedAt         DateTime?
  orNumber           String?
  orDate             DateTime?
  remarks            String?

  pointPerson        String?
  checksPossession   String?

  clearingStatus     ClearingStatus   @default(NONE)
  crNumber           String?
  clearedDate        DateTime?

  cancelledById      String?
  cancelledAt        DateTime?
  cancelReason       String?

  sourceSheet        String?
  sourceRow          Int?
  isStale            Boolean          @default(false)

  acumaticaDocType   String?
  acumaticaStatus    String?
  acumaticaBranch    String?
  acumaticaTenant    AcumaticaTenant?
  lastModifiedOn     DateTime?
  voidedAt           DateTime?

  company            Company          @relation(fields: [companyId], references: [id])
  cashAccount        CashAccount?     @relation(fields: [cashAccountId], references: [id])
  checkBook          CheckBook?       @relation(fields: [checkBookId], references: [id])
  vendor             Vendor?          @relation(fields: [vendorId], references: [id])
  signedBy           User?            @relation("signedBy", fields: [signedById], references: [id])
  readyBy            User?            @relation("readyBy", fields: [readyById], references: [id])
  releasedBy         User?            @relation("releasedBy", fields: [releasedById], references: [id])
  cancelledBy        User?            @relation("cancelledBy", fields: [cancelledById], references: [id])
  eligibilityOverriddenBy User?       @relation("eligibilityOverriddenBy", fields: [eligibilityOverriddenById], references: [id])

  bills              CheckBill[]
  auditLogs          AuditLog[]
  portalEvents       PortalEvent[]
  notifications      Notification[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([companyId, checkNumber])
  @@index([status])
  @@index([eligibility])
  @@index([checkDate])
  @@index([availablePickupDate])
}

// Which ingestion path a row came in on. The same enum `NormalisedRow.source`
// carries, so a staged row says outright where it is from instead of leaving a
// reader to infer it from which provenance columns happen to be filled.
enum IngestSource {
  WORKBOOK
  ACUMATICA
}

enum StagedReason {
  // 2,640 register rows: neither a checkbook nor a cash account, so nothing
  // says which company's cheque this is.
  NO_COMPANY
  // 66 register rows: no cheque number at all, so the row cannot be keyed.
  // Since 2026-09-04 also 80 Acumatica payments: PaymentMethod CHK — genuinely
  // cheques — whose PaymentRef is a memo ("Oct interest", "pay 12 25 2nd")
  // rather than a number. Finance ruled they get exactly this treatment, so a
  // human can supply the real number from `statedCheckRef`.
  NO_CHECK_NUMBER
  // 61 register rows across 27 cheque numbers: the number resolves to MORE
  // THAN ONE company. Finance ruling of 2026-09-03 — stage every row for such
  // a number and import none of them. Measured: 25 of the 27 are one cheque
  // entered twice under a different checkbook code with an identical amount and
  // payee, and importing both rows would file one physical cheque under two
  // companies and double-count PHP 6,779,371.05. The other 2 carry genuinely
  // different payees and amounts under one number.
  AMBIGUOUS_COMPANY
}

// A register row kept whole because it cannot become a `Check` without a guess.
// `Check.companyId` is required and is half of `@@unique([companyId,
// checkNumber])`, so a row whose company is unknown, contested, or whose cheque
// number is missing has no key to be written under. Staging is what makes
// "nothing is dropped" true: every one of the register's 12,227 rows is either
// imported or sits here where Finance can see it. The Acumatica sync promotes
// them later, by cheque number, once it supplies a company.
model StagedCheck {
  id              String       @id @default(cuid())
  // Which path staged this row, and therefore which identity columns below are
  // filled. NOT NULL and no default: a staged row that does not say where it
  // came from cannot be keyed, and a default would quietly make Acumatica rows
  // look like workbook ones.
  source          IngestSource
  // The register's identity: the cell a human can be pointed at. Null for an
  // Acumatica row, which has no sheet and no row number — do NOT fake a sheet
  // name like 'ACUMATICA' to squeeze one into this key. A reconciliation report
  // reads this column as a sheet.
  sourceSheet     String?
  sourceRow       Int?
  // The Acumatica identity: the payment document's own ReferenceNbr, plus the
  // tenant, because the two tenants number their vouchers alike (both write
  // CV-ST…) while `ST` means a different company in each. Null for a workbook
  // row. Together these are what makes a re-run of the sync update a staged row
  // instead of adding another.
  acumaticaRef    String?
  acumaticaTenant AcumaticaTenant?
  reason          StagedReason
  checkNumber     String?
  // What the source printed where a cheque number belongs, verbatim. The whole
  // point of a NO_CHECK_NUMBER row from Acumatica: `checkNumber` is null
  // because the memo cannot key a cheque, and this is what a human reads in
  // order to supply the real number. Never promote it into `checkNumber`.
  statedCheckRef  String?
  cvNumber        String?
  apvNumbers      String[]
  poNumbers       String[]
  checkBookCode   String?
  cashAccountCode String?
  // What THIS row's own signals resolved to, null when they resolved nothing.
  // Kept alongside the two code columns so a human settling an AMBIGUOUS_COMPANY
  // group can see which signal claimed which company without reopening the
  // workbook.
  companyCode     String?
  // Every company code the cheque number resolved to across the whole import.
  // Empty unless `reason` is AMBIGUOUS_COMPANY. This is a fact about the group,
  // not about this row, and is repeated on each row of the group deliberately:
  // the alternative is a self-join to find out why a row was staged.
  conflictingCompanies String[]
  category        String?
  clearingRef     String?
  checkDate       DateTime?
  amount          Decimal?     @db.Decimal(18, 2)
  currency        String?
  payeeName       String?
  impliedStatus   CheckStatus
  // Set when the Acumatica sync later supplies the company (Task 9). Left alone
  // by the importer: a cheque number is unique only per company, so matching a
  // staged row to a new Check on the number alone could link it to a sibling
  // company's cheque. That is a guess about money, which is what staging exists
  // to avoid.
  promotedCheckId String?
  createdAt       DateTime     @default(now())

  // One unique key per origin, so re-running either ingestion path updates a
  // staged row and never duplicates it. Postgres treats NULLs as distinct, so
  // each key constrains only the rows that actually carry it — which is why
  // `stageRow` refuses outright to stage a row whose own identity columns are
  // null rather than letting it slip past a key that cannot see it. The
  // `staged_check_one_source_identity` CHECK constraint added in
  // `20260904190000_staged_check_source` enforces that a row fills exactly one
  // of the two.
  @@unique([sourceSheet, sourceRow])
  @@unique([acumaticaTenant, acumaticaRef])
  @@index([checkNumber])               // the Acumatica sync matches on this
  @@index([reason])
  @@index([source])
}

model CheckBill {
  id            String    @id @default(cuid())
  checkId       String
  apvNumber     String
  poNumber      String?
  rrNumber      String?
  statusRr      String?
  description   String?
  glAccount     String?
  dueDate       DateTime?
  termsCode     String?
  amount        Decimal   @db.Decimal(18, 2)
  createdByName String?

  check         Check     @relation(fields: [checkId], references: [id], onDelete: Cascade)

  // The idempotency key for the approval-for-release import: re-running it
  // updates a bill rather than adding a second copy of it.
  //
  // Note what this deliberately does NOT constrain. It is `(checkId,
  // apvNumber)`, not `checkId`: a cheque settling several bills is routine in
  // the register, and `CheckBill` is correctly one-to-many. All 85 rows of the
  // 4 September approval-for-release snapshot name distinct cheques, but that
  // is a property of one day's working list. Do not narrow this to `checkId`.
  @@unique([checkId, apvNumber])
  @@index([apvNumber])
  @@index([poNumber])
}

model AuditLog {
  id        String    @id @default(cuid())
  checkId   String?
  actorType ActorType
  userId    String?
  action    String
  details   Json?
  remarks   String?
  createdAt DateTime  @default(now())

  check     Check?    @relation(fields: [checkId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([checkId, createdAt])
}

// The outbox. `lib/domain/actions.ts` writes one of these in the same
// transaction as the status change it describes, so the change commits even when
// the portal is unreachable, and a worker delivers it later.
model PortalEvent {
  id             String            @id @default(cuid())
  checkId        String
  direction      PortalDirection
  kind           PortalEventKind
  payload        Json
  status         PortalEventStatus @default(PENDING)
  attempts       Int               @default(0)
  lastError      String?

  // When this event next becomes eligible for delivery. Backoff is expressed as
  // a time rather than a sleep so the worker stays stateless and a restart does
  // not reset every backoff to zero.
  nextAttemptAt  DateTime          @default(now())

  // Claim columns. A worker sets both in one conditional update, so two workers
  // cannot deliver the same event — which for MARK_AVAILABLE would be two
  // notifications to one supplier.
  claimedAt      DateTime?
  claimedBy      String?

  // One instruction per (check, kind, attempt-generation), where the generation
  // is the acting timestamp: see the key builder in lib/domain/actions.ts. The
  // outbox must not be able to queue the same instruction twice.
  //
  // This is our own guarantee against duplicate WORK, not the last line of
  // defence against double-notifying a supplier — the portal holds an
  // application-level notify-exactly-once latch of its own (confirmed from its
  // source, 2026-09-04). Both exist; neither is a reason to relax the other.
  idempotencyKey String            @unique

  createdAt      DateTime          @default(now())
  check          Check             @relation(fields: [checkId], references: [id])

  // The worker's claim query is `status = PENDING AND nextAttemptAt <= now`, so
  // the index is on those two and not on createdAt as it was before this model
  // became a queue.
  @@index([status, nextAttemptAt])
  @@index([checkId])
}

model SyncRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  mode       String
  // Which Acumatica tenant this run read. The two tenants reuse branch codes for
  // different companies, so a run that does not say which one it was is not
  // interpretable, and a "last sync" figure pooled across both is a number about
  // nothing. Nullable only because the column post-dates the model and nothing
  // had ever written a SyncRun row to back-fill; `runSync` always sets it.
  tenant     String?
  // Where the NEXT incremental run should start: the maximum LastModifiedOn this
  // run saw, minus the 120-minute overlap. Kept on the run that computed it
  // rather than in one mutable setting, so a run's own record says where it left
  // off. Null when the run took responsibility for no rows, which leaves the
  // previous run's watermark standing.
  watermark  DateTime?
  imported   Int       @default(0)
  updated    Int       @default(0)
  // Payments this run could not write and kept whole instead — since 2026-09-04
  // an Acumatica row CAN be staged. Recorded because these were previously
  // counted as errors, and a run that quietly stages 80 payments nobody is told
  // about is worse than one that reports them as failures.
  staged     Int       @default(0)
  errors     Int       @default(0)
  message    String?

  @@index([tenant, startedAt])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  checkId   String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  check     Check?   @relation(fields: [checkId], references: [id])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(FINANCE_USER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  auditLogs         AuditLog[]
  signedChecks      Check[]   @relation("signedBy")
  readyChecks       Check[]   @relation("readyBy")
  releasedChecks    Check[]   @relation("releasedBy")
  cancelledChecks   Check[]   @relation("cancelledBy")
  overriddenChecks  Check[]   @relation("eligibilityOverriddenBy")
}

model Setting {
  key   String @id
  value String
}
