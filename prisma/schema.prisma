generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations take Postgres advisory locks, which Neon's pooled (PgBouncer)
  // endpoint does not support. `directUrl` is the same connection string with
  // "-pooler" removed, and is used by Prisma Migrate only.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  FINANCE_USER
  FINANCE_ADMIN
}

enum CheckStatus {
  GENERATED
  SIGNATURE_PENDING
  SIGNED
  READY_FOR_RELEASE
  SCHEDULED
  RELEASED
  CANCELLED
  VOIDED
}

enum AcumaticaTenant {
  GOLIVE
  MANUFACTURING
}

enum ClearingStatus {
  NONE
  DEPOSITED
  ENCASHED
  CLEARED
}

// Which piece of paper the supplier handed over when they collected the cheque:
// an Official Receipt or a Collection Receipt.
//
// Stored rather than parsed back out of the reference string. "OR-000123",
// "4471" and "CR 88" are all references a supplier writes, and a prefix rule
// over them would be a guess dressed as a fact — this register has already
// taught the project what positional and prefix guesses cost. Finance answers
// once, and the answer is a column, which is also what makes "how many CRs did
// we take in September" a query rather than a re-parse.
//
// CR here is a COLLECTION RECEIPT. It is not `Check.crNumber`, which sits
// beside `clearingStatus` and holds the BANK's clearing reference weeks later.
// See the note on `receiptType` below.
enum ReceiptType {
  OR
  CR
}

enum Eligibility {
  SUPPLIER
  BROKER
  INTERNAL
}

enum PortalDomain {
  LOCAL
  BROKER
}

enum PortalSyncStatus {
  NOT_APPLICABLE
  PENDING
  SYNCED
  FAILED
}

enum ActorType {
  SYSTEM
  USER
}

enum PortalDirection {
  OUT
  IN
}

enum PortalEventStatus {
  PENDING
  IN_FLIGHT
  SYNCED
  FAILED
  // Terminal and deliberate: delivery was abandoned and a human must look.
  // Distinct from FAILED, which is retryable.
  PARKED
}

// What an event instructs the portal to do. Deliberately NOT the same set as
// `PortalSyncStatus`, which is a cheque's state; this is one message about it.
enum PortalEventKind {
  MARK_AVAILABLE
  REVERT
  // The third call site. `markReleased` in lib/domain/actions.ts already queues
  // this and a test pins it. It IS deliverable: the portal's POST /api/checks/:id
  // accepts `status`, `orNumber` and `orDate` at encoder tier. Plan 3's first
  // draft omitted it because it was written against two of the three
  // portalEvent.create sites that actually exist. Do not remove it.
  RELEASED
  // A release undone by a FINANCE_ADMIN: the cheque is back at READY_FOR_RELEASE
  // and the supplier may still collect it. Deliberately NOT `REVERT`, which the
  // portal reads as "withdrawn for re-upload" (its status REVERTED_FOR_REUPLOADING)
  // — the opposite of what happened. Delivered, when Plan 3 delivers anything,
  // through the same `POST /api/checks/:id` that carries RELEASED, with
  // `status: AVAILABLE_FOR_RELEASE`. Client ruling 2026-09-11.
  RELEASE_REVERSED
}

model Company {
  id           String           @id @default(cuid())
  code         String           @unique   // STK, A1+, P&P
  name         String
  tenant       AcumaticaTenant?
  branch       String?
  legalNames   String[]                   // used by eligibility to detect inter-company
  cashAccounts CashAccount[]
  checkBooks   CheckBook[]
  checks       Check[]
  createdAt    DateTime         @default(now())

  @@unique([tenant, branch])
}

model Bank {
  id           String        @id @default(cuid())
  code         String        @unique   // BPI, MBTC, BDO
  name         String
  cashAccounts CashAccount[]
  checkBooks   CheckBook[]
}

model CashAccount {
  id        String  @id @default(cuid())
  code      String  @unique            // "BPI STK"
  bankId    String
  companyId String
  bank      Bank    @relation(fields: [bankId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  checks    Check[]
}

model CheckBook {
  id        String  @id @default(cuid())
  code      String  @unique            // "BPI-S-4636"
  bankId    String
  companyId String
  bank      Bank    @relation(fields: [bankId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  checks    Check[]
}

model Vendor {
  id                  String       @id @default(cuid())
  vendorId            String?      @unique
  canonicalName       String       @unique
  aliases             String[]
  eligibilityDefault  Eligibility?
  checks              Check[]
}

// @@check "check_internal_never_routes_to_portal" (migration
// 20260901140000_internal_never_routes_to_portal): Prisma does not manage
// CHECK constraints, so this comment is the record of one that exists only
// in the database. It enforces that an INTERNAL check can never carry portal
// routing state:
//   eligibility <> 'INTERNAL'
//   OR (portalDomain IS NULL AND portalSyncStatus = 'NOT_APPLICABLE')
model Check {
  id                 String           @id @default(cuid())
  acumaticaPaymentId String?          @unique

  checkNumber        String
  cvNumber           String?
  // The AP vouchers this cheque settles, as the SOURCE states them. A reference
  // list, not a ledger: `CheckBill` holds the per-bill amount, due date, terms
  // and GL account, and comes from the approval-for-release workbook whose grain
  // is one row per bill. The register's grain is one row per CHEQUE and its
  // amount cell is the CHEQUE's amount, so a register row cannot produce a
  // `CheckBill` without inventing a per-bill figure. It produces this instead.
  //
  // Measured 2026-09-07 over `CHECK MONITORING 9.1.2026.xlsx`: the column headed
  // VOUCHER NUMBER (column 8) carries 11,944 AP references and no CV at all,
  // while the column headed CHECKS APV (column 4) carries 11,584 CV references
  // and exactly one AP. The headers are swapped with respect to their contents;
  // the parser has always discriminated on the `AP-`/`CV-` prefix rather than on
  // the position, which is why the CV numbers landed correctly all along and the
  // vouchers had nowhere to land. 11,552 of the register's 11,779 distinct
  // cheque numbers carry at least one.
  //
  // An import UNIONS rather than replaces (see `upsertCheck`): a cheque
  // appearing on two register sheets is one cheque recorded twice, and 11 of the
  // 360 multi-row cheque numbers state a different voucher on each row. An
  // empty incoming array — every Acumatica row — never clears what the register
  // recorded.
  apvNumbers         String[]
  checkDate          DateTime?
  // Nullable because the register genuinely does not always know them: of its
  // 12,161 parsed rows, 397 carry no amount (260 blank, 135 where the amount
  // column holds the word "CANCELLED", 2 shifted rows holding a date) and 153
  // carry no payee. NULL means "not recorded" - it is not a synonym for 0.00 or
  // for ''. Storing 0.00 would understate every per-currency total the cheque
  // appears in and would be indistinguishable from a real zero-value cheque;
  // storing '' would read as a cheque payable to nobody. The domain has modelled
  // both as nullable since Plan 1 (ReadyGuardInput, REQUIRED_FIELDS), so
  // checkReadyForRelease already blocks release until someone fills the gap in,
  // and classifyEligibility already answers INTERNAL for an absent payee - which
  // is what keeps such a cheque off the supplier portal. Do not "tidy" these
  // back to NOT NULL with a default.
  amount             Decimal?         @db.Decimal(18, 2)
  currency           String           @default("PHP")

  // Not every Acumatica payment is a cheque. The China offices pay by transfer,
  // and their PaymentRef carries an AP reference rather than a cheque number.
  // Such a payment is tracked but has no physical document to sign or hand over.
  isCheque           Boolean          @default(true)

  companyId          String
  cashAccountId      String?
  checkBookId        String?
  vendorId           String?
  payeeName          String?          // see the note on `amount` above

  category           String?
  eligibility        Eligibility
  eligibilityOverriddenById String?

  portalTradeId      Int?
  portalDomain       PortalDomain?
  portalSyncStatus   PortalSyncStatus @default(NOT_APPLICABLE)

  status             CheckStatus      @default(GENERATED)

  signedById            String?
  signedAt              DateTime?
  readyById             String?
  readyAt               DateTime?
  availablePickupDate   DateTime?

  scheduledPickupDate   DateTime?
  scheduledPickupTime   String?
  pickupRep             String?
  portalConfirmedAt     DateTime?

  releasedById       String?
  releasedAt         DateTime?
  // The supplier's receipt: the paper handed over when the cheque is collected.
  // All three are Finance facts recorded at, or after, the moment of release,
  // and all three are optional — the client's ruling is that a cheque may be
  // released with the box empty and the receipt added later.
  //
  // `receiptType` says WHICH kind of receipt `orNumber` names, and it is null
  // exactly when `orNumber` is: `normaliseReceipt` in lib/domain/receipt.ts
  // drops a type with no reference, and `checkReceipt` refuses a reference with
  // no type. There is deliberately no default — a default would answer, on
  // every one of the 21,817 existing rows, a question nobody was asked.
  //
  // **`crNumber`, further down, is NOT this.** It is the BANK's clearing
  // reference, recorded weeks after release beside `clearingStatus` and
  // `clearedDate`. A supplier's Collection Receipt written there would read to
  // every report as evidence the cheque had cleared the bank.
  orNumber           String?
  orDate             DateTime?
  receiptType        ReceiptType?
  remarks            String?

  pointPerson        String?
  checksPossession   String?

  // BANK CLEARING, not a receipt. `crNumber` is the reference the bank gives
  // when the cheque comes back through the account, and it is written only by
  // `recordClearing` alongside a `clearingStatus` move. A supplier's Collection
  // Receipt goes in `receiptType` = CR with its number in `orNumber`; putting
  // one here would make an uncollected cheque read as cleared money.
  clearingStatus     ClearingStatus   @default(NONE)
  crNumber           String?
  clearedDate        DateTime?

  cancelledById      String?
  cancelledAt        DateTime?
  cancelReason       String?

  sourceSheet        String?
  sourceRow          Int?
  // Reserved for the stale-check queue of the design's R3: 88 CHECK FINDING
  // rows are 2025 cheques still sitting AVAILABLE, to be reviewed rather than
  // auto-released or auto-cancelled. Nothing sets or reads it yet. It is NOT a
  // synonym for `isIncomplete` below — a stale cheque is one that has sat too
  // long, an incomplete one is missing a fact — and the two must not be folded
  // together: a cheque can be either, both, or neither.
  isStale            Boolean          @default(false)
  // "The amount is not recorded." A stored derivation of `amount IS NULL`,
  // maintained by `upsertCheck` (the only writer of `amount`) and repairable by
  // `scripts/backfill-incomplete.ts`. Measured against production on
  // 2026-09-04: 129 of its 9,247 register-derived cheques carry no amount
  // (21,817 rows in the table altogether — the rest came from Acumatica, and
  // every one of the 129 is a register row), because the register's amount cell
  // was blank or held the word "CANCELLED". Acumatica, reconciled against all
  // 129, has no record of any of them. 83 name a real payee, so they are
  // genuine records to be reviewed, not junk to be hidden.
  //
  // Stored rather than derived at query time so the dashboard can filter and
  // count on an index over 21,817 rows. It is a VIEW aid and nothing more: no
  // safety control reads it. `checkDeletable` tests `amount` itself, because a
  // stored boolean can drift from the column it describes and a rule about
  // deleting money records must read the fact, not the cache of it.
  isIncomplete       Boolean          @default(false)

  acumaticaDocType   String?
  acumaticaStatus    String?
  acumaticaBranch    String?
  acumaticaTenant    AcumaticaTenant?
  lastModifiedOn     DateTime?
  voidedAt           DateTime?

  company            Company          @relation(fields: [companyId], references: [id])
  cashAccount        CashAccount?     @relation(fields: [cashAccountId], references: [id])
  checkBook          CheckBook?       @relation(fields: [checkBookId], references: [id])
  vendor             Vendor?          @relation(fields: [vendorId], references: [id])
  signedBy           User?            @relation("signedBy", fields: [signedById], references: [id])
  readyBy            User?            @relation("readyBy", fields: [readyById], references: [id])
  releasedBy         User?            @relation("releasedBy", fields: [releasedById], references: [id])
  cancelledBy        User?            @relation("cancelledBy", fields: [cancelledById], references: [id])
  eligibilityOverriddenBy User?       @relation("eligibilityOverriddenBy", fields: [eligibilityOverriddenById], references: [id])

  bills              CheckBill[]
  auditLogs          AuditLog[]
  portalEvents       PortalEvent[]
  notifications      Notification[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([companyId, checkNumber])
  // The composite unique above cannot serve a lookup on the number alone —
  // `companyId` is its leading column. `upsertCheck` falls back to exactly that
  // lookup whenever the composite key misses (see COMPANY_RULING_BASIS), which
  // is every create and every cheque Acumatica files under a different company
  // from the register. Without this index that is a sequential scan of 21,817
  // rows, thousands of times per import.
  @@index([checkNumber])
  @@index([status])
  @@index([eligibility])
  @@index([checkDate])
  @@index([availablePickupDate])
  // 129 true rows in 9,247. The dashboard filter and its count both read this
  // column, and a sequential scan for a card rendered on every page load is the
  // one thing that would make the feature not worth having.
  @@index([isIncomplete])
  // GIN, because the lookup this serves is `apvNumbers @> ARRAY['AP-ST042652']`
  // — the approval workbook's fallback when its `check No.` cell does not hold
  // a cheque number. A B-tree cannot answer containment on an array, so without
  // this every such bill is a sequential scan of 21,817 rows.
  @@index([apvNumbers], type: Gin)
}

// Which ingestion path a row came in on. The same enum `NormalisedRow.source`
// carries, so a staged row says outright where it is from instead of leaving a
// reader to infer it from which provenance columns happen to be filled.
enum IngestSource {
  WORKBOOK
  ACUMATICA
}

enum StagedReason {
  // 2,640 register rows: neither a checkbook nor a cash account, so nothing
  // says which company's cheque this is.
  NO_COMPANY
  // 66 register rows: no cheque number at all, so the row cannot be keyed.
  // Since 2026-09-04 also 80 Acumatica payments: PaymentMethod CHK — genuinely
  // cheques — whose PaymentRef is a memo ("Oct interest", "pay 12 25 2nd")
  // rather than a number. Finance ruled they get exactly this treatment, so a
  // human can supply the real number from `statedCheckRef`.
  NO_CHECK_NUMBER
  // 61 register rows across 27 cheque numbers: the number resolves to MORE
  // THAN ONE company. Finance ruling of 2026-09-03 — stage every row for such
  // a number and import none of them. Measured: 25 of the 27 are one cheque
  // entered twice under a different checkbook code with an identical amount and
  // payee, and importing both rows would file one physical cheque under two
  // companies and double-count PHP 6,779,371.05. The other 2 carry genuinely
  // different payees and amounts under one number.
  AMBIGUOUS_COMPANY
}

// A register row kept whole because it cannot become a `Check` without a guess.
// `Check.companyId` is required and is half of `@@unique([companyId,
// checkNumber])`, so a row whose company is unknown, contested, or whose cheque
// number is missing has no key to be written under. Staging is what makes
// "nothing is dropped" true: every one of the register's 12,227 rows is either
// imported or sits here where Finance can see it. The Acumatica sync promotes
// them later, by cheque number, once it supplies a company.
model StagedCheck {
  id              String       @id @default(cuid())
  // Which path staged this row, and therefore which identity columns below are
  // filled. NOT NULL and no default: a staged row that does not say where it
  // came from cannot be keyed, and a default would quietly make Acumatica rows
  // look like workbook ones.
  source          IngestSource
  // The register's identity: the cell a human can be pointed at. Null for an
  // Acumatica row, which has no sheet and no row number — do NOT fake a sheet
  // name like 'ACUMATICA' to squeeze one into this key. A reconciliation report
  // reads this column as a sheet.
  sourceSheet     String?
  sourceRow       Int?
  // The Acumatica identity: the payment document's own ReferenceNbr, plus the
  // tenant, because the two tenants number their vouchers alike (both write
  // CV-ST…) while `ST` means a different company in each. Null for a workbook
  // row. Together these are what makes a re-run of the sync update a staged row
  // instead of adding another.
  acumaticaRef    String?
  acumaticaTenant AcumaticaTenant?
  reason          StagedReason
  checkNumber     String?
  // What the source printed where a cheque number belongs, verbatim. The whole
  // point of a NO_CHECK_NUMBER row from Acumatica: `checkNumber` is null
  // because the memo cannot key a cheque, and this is what a human reads in
  // order to supply the real number. Never promote it into `checkNumber`.
  statedCheckRef  String?
  cvNumber        String?
  apvNumbers      String[]
  poNumbers       String[]
  checkBookCode   String?
  cashAccountCode String?
  // What THIS row's own signals resolved to, null when they resolved nothing.
  // Kept alongside the two code columns so a human settling an AMBIGUOUS_COMPANY
  // group can see which signal claimed which company without reopening the
  // workbook.
  companyCode     String?
  // Every company code the cheque number resolved to across the whole import.
  // Empty unless `reason` is AMBIGUOUS_COMPANY. This is a fact about the group,
  // not about this row, and is repeated on each row of the group deliberately:
  // the alternative is a self-join to find out why a row was staged.
  conflictingCompanies String[]
  category        String?
  clearingRef     String?
  checkDate       DateTime?
  amount          Decimal?     @db.Decimal(18, 2)
  currency        String?
  payeeName       String?
  impliedStatus   CheckStatus
  // Set when the Acumatica sync later supplies the company (Task 9). Left alone
  // by the importer: a cheque number is unique only per company, so matching a
  // staged row to a new Check on the number alone could link it to a sibling
  // company's cheque. That is a guess about money, which is what staging exists
  // to avoid.
  promotedCheckId String?
  createdAt       DateTime     @default(now())

  // One unique key per origin, so re-running either ingestion path updates a
  // staged row and never duplicates it. Postgres treats NULLs as distinct, so
  // each key constrains only the rows that actually carry it — which is why
  // `stageRow` refuses outright to stage a row whose own identity columns are
  // null rather than letting it slip past a key that cannot see it. The
  // `staged_check_one_source_identity` CHECK constraint added in
  // `20260904190000_staged_check_source` enforces that a row fills exactly one
  // of the two.
  @@unique([sourceSheet, sourceRow])
  @@unique([acumaticaTenant, acumaticaRef])
  @@index([checkNumber])               // the Acumatica sync matches on this
  @@index([reason])
  @@index([source])
}

model CheckBill {
  id            String    @id @default(cuid())
  checkId       String
  apvNumber     String
  poNumber      String?
  rrNumber      String?
  statusRr      String?
  description   String?
  glAccount     String?
  dueDate       DateTime?
  termsCode     String?
  amount        Decimal   @db.Decimal(18, 2)
  createdByName String?

  check         Check     @relation(fields: [checkId], references: [id], onDelete: Cascade)

  // The idempotency key for the approval-for-release import: re-running it
  // updates a bill rather than adding a second copy of it.
  //
  // Note what this deliberately does NOT constrain. It is `(checkId,
  // apvNumber)`, not `checkId`: a cheque settling several bills is routine in
  // the register, and `CheckBill` is correctly one-to-many. All 85 rows of the
  // 4 September approval-for-release snapshot name distinct cheques, but that
  // is a property of one day's working list. Do not narrow this to `checkId`.
  @@unique([checkId, apvNumber])
  @@index([apvNumber])
  @@index([poNumber])
}

// Why a row of the approval-for-release workbook produced no `CheckBill`.
//
// The first three are decided against the database and can change between runs;
// the last two are decided by the parser and cannot. They are one enum because
// the person reading the queue does not care which half of the importer refused
// the row, only that the row is not attached to a cheque.
enum StagedBillReason {
  // The `check No.` cell holds no cheque number AND the row's voucher matched
  // no cheque here. Row 81 of the 4 September LIST sheet is the measured case:
  // the cell holds a date, 2026-08-13, which is cheque 6000353106's own date.
  // Once the register's vouchers are loaded the voucher resolves it and the row
  // stops being staged; until then it is exactly this.
  NO_CHECK_NUMBER
  // A usable cheque number, or a voucher, that names no cheque in this system.
  // Expected rather than wrong: the cheque may be staged for want of a company,
  // or simply absent from the register.
  NO_MATCHING_CHECK
  // The number or the voucher matches MORE THAN ONE cheque. Never resolved by
  // picking one — a bill hung on the wrong cheque is a supplier told the wrong
  // thing, and the `bank` column that would break the tie is this module
  // deciding which company a bill belongs to.
  AMBIGUOUS_CHECK
  // No `Reference Nbr.` at all, so there is no voucher to key `CheckBill` on.
  NO_APV
  // No usable `Detail Total`. `CheckBill.amount` is NOT NULL and a bill amount
  // is never invented to satisfy it.
  NO_AMOUNT
}

/**
 * A row of `APPROVAL FOR RELEASE 9.4.2026.xlsx` that produced no `CheckBill`,
 * kept where somebody sees it.
 *
 * It exists because of one cheque. Voucher `AP-ST042652` never reached the
 * supplier portal, and the cause was a single mis-keyed cell: row 81 of the
 * LIST sheet holds a date where the cheque number belongs. The importer refused
 * the row correctly and reported it correctly — to a terminal, once, during a
 * run nobody was watching. A rejected row has to survive the run that rejected
 * it, or the next person to notice is the supplier.
 *
 * Deliberately NOT a `StagedCheck`. That table holds rows that could not become
 * a CHEQUE, and every one of them carries an `impliedStatus`; a bill implies no
 * status at all — this workbook's `FINANCE REMARKS` reads AVAILABLE on all 85
 * rows and is evidence, never an instruction — so squeezing a bill into it
 * would mean inventing one. The two are surfaced on the same page, which is
 * what "one place to look" actually requires.
 *
 * It carries no amount and no vendor. A human fixing a mis-keyed cheque cell
 * needs the sheet, the row, the voucher and what the cell actually said; the
 * bill's `Detail Total` beside a cheque-shaped row would sooner or later be
 * read as the cheque's amount, and this table is displayed next to one whose
 * amounts are exactly that.
 */
model StagedBill {
  id              String           @id @default(cuid())
  // The cell a human is pointed at, and the idempotency key: re-running the
  // import updates a staged row rather than adding a second one, and a row that
  // has since resolved is deleted by the same pass that stages the rest.
  sourceSheet     String
  sourceRow       Int
  reason          StagedBillReason
  // What the `check No.` cell actually held, verbatim — a date, a memo, or
  // nothing. This is what a human replaces with the real number, so it must not
  // be normalised, and it is never promoted into a cheque number.
  statedCheckRef  String?
  // Canonical, where the cell did hold one. Null when it did not.
  checkNumber     String?
  apvNumber       String?
  poNumber        String?
  // Every company code a contested cheque number resolves to, for the human who
  // has to settle it. Empty unless `reason` is AMBIGUOUS_CHECK.
  companies       String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([sourceSheet, sourceRow])
  @@index([reason])
}

model AuditLog {
  id        String    @id @default(cuid())
  checkId   String?
  actorType ActorType
  userId    String?
  action    String
  details   Json?
  remarks   String?
  createdAt DateTime  @default(now())

  // `onDelete: SetNull`, stated rather than left to Prisma's default for an
  // optional relation — which is SetNull, so this declaration changes no SQL
  // and exists to make the decision impossible to change by accident.
  //
  // It is what makes `deleteIncompleteCheck` safe: an audit row is the record
  // of WHO TOUCHED MONEY, and it survives its cheque's deletion detached but
  // otherwise byte-identical — action, details, remarks, actor and timestamp
  // all intact. Cascade would destroy exactly the evidence the append-only
  // trigger exists to protect, and the trigger would refuse it anyway. Do not
  // "tidy" this to Cascade, and do not add one to make a delete go through.
  //
  // The detaching UPDATE is itself the single exemption in the append-only
  // trigger (migration 20260905000100_audit_log_detach_on_check_delete), granted
  // only when the referenced cheque is genuinely gone. Read that migration
  // before changing anything here.
  check     Check?    @relation(fields: [checkId], references: [id], onDelete: SetNull)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([checkId, createdAt])
}

// The outbox. `lib/domain/actions.ts` writes one of these in the same
// transaction as the status change it describes, so the change commits even when
// the portal is unreachable, and a worker delivers it later.
model PortalEvent {
  id             String            @id @default(cuid())
  checkId        String
  direction      PortalDirection
  kind           PortalEventKind
  payload        Json
  status         PortalEventStatus @default(PENDING)
  attempts       Int               @default(0)
  lastError      String?

  // When this event next becomes eligible for delivery. Backoff is expressed as
  // a time rather than a sleep so the worker stays stateless and a restart does
  // not reset every backoff to zero.
  nextAttemptAt  DateTime          @default(now())

  // Claim columns. A worker sets both in one conditional update, so two workers
  // cannot deliver the same event — which for MARK_AVAILABLE would be two
  // notifications to one supplier.
  claimedAt      DateTime?
  claimedBy      String?

  // One instruction per (check, kind, attempt-generation), where the generation
  // is the acting timestamp: see the key builder in lib/domain/actions.ts. The
  // outbox must not be able to queue the same instruction twice.
  //
  // This is our own guarantee against duplicate WORK, not the last line of
  // defence against double-notifying a supplier — the portal holds an
  // application-level notify-exactly-once latch of its own (confirmed from its
  // source, 2026-09-04). Both exist; neither is a reason to relax the other.
  idempotencyKey String            @unique

  createdAt      DateTime          @default(now())
  // `onDelete: Restrict`, stated rather than left to Prisma's default for a
  // required relation — which is Restrict, so this declaration changes no SQL.
  // `checkId` is NOT NULL, so an event cannot be detached the way an audit row
  // can, and an event is an instruction to tell a supplier something about a
  // cheque. The database refusing the delete is the backstop;
  // `deleteIncompleteCheck` refuses first, with a sentence a Finance Admin can
  // act on rather than a foreign-key violation. Neither is redundant.
  check          Check             @relation(fields: [checkId], references: [id], onDelete: Restrict)

  // The worker's claim query is `status = PENDING AND nextAttemptAt <= now`, so
  // the index is on those two and not on createdAt as it was before this model
  // became a queue.
  @@index([status, nextAttemptAt])
  @@index([checkId])
}

model SyncRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  mode       String
  // Which Acumatica tenant this run read. The two tenants reuse branch codes for
  // different companies, so a run that does not say which one it was is not
  // interpretable, and a "last sync" figure pooled across both is a number about
  // nothing. Nullable only because the column post-dates the model and nothing
  // had ever written a SyncRun row to back-fill; `runSync` always sets it.
  tenant     String?
  // Where the NEXT incremental run should start: the maximum LastModifiedOn this
  // run saw, minus the 120-minute overlap. Kept on the run that computed it
  // rather than in one mutable setting, so a run's own record says where it left
  // off. Null when the run took responsibility for no rows, which leaves the
  // previous run's watermark standing.
  watermark  DateTime?
  // Who started the run: a person pressing SYNC NOW, or the schedule. A string
  // like `mode` and `tenant` beside it. Defaults to MANUAL because that is the
  // truth about every row written before the column existed — all thirteen of
  // them were clicked. `runSync` always sets it; the default is for history, not
  // for callers, and `SyncArgs.trigger` is required for exactly that reason.
  trigger    String    @default("MANUAL")
  imported   Int       @default(0)
  updated    Int       @default(0)
  // Payments this run could not write and kept whole instead — since 2026-09-04
  // an Acumatica row CAN be staged. Recorded because these were previously
  // counted as errors, and a run that quietly stages 80 payments nobody is told
  // about is worse than one that reports them as failures.
  staged     Int       @default(0)
  errors     Int       @default(0)
  message    String?

  @@index([tenant, startedAt])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  checkId   String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  check     Check?   @relation(fields: [checkId], references: [id])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(FINANCE_USER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  auditLogs         AuditLog[]
  signedChecks      Check[]   @relation("signedBy")
  readyChecks       Check[]   @relation("readyBy")
  releasedChecks    Check[]   @relation("releasedBy")
  cancelledChecks   Check[]   @relation("cancelledBy")
  overriddenChecks  Check[]   @relation("eligibilityOverriddenBy")
}

model Setting {
  key   String @id
  value String
}

/// Every attempt to sign in, successful or not. The counter that
/// `lib/login-throttle.ts` throttles on, and the only record anyone will ever
/// have that an attack happened.
///
/// **This lives in Postgres and must stay there.** The deployment target is
/// Vercel, which is serverless: an in-memory `Map` keyed on email or IP is
/// per-lambda, every cold start begins at zero, and an attacker's requests
/// spread across instances by design. A counter like that reads as a control
/// and is not one. Neon is already the source of truth for everything else
/// here; it is the source of truth for this too. Do not "optimise" this into
/// process memory, and do not add Redis for it.
///
/// `email` is deliberately NOT a relation to `User`. The whole point of
/// throttling on the address is that it works for an address no account
/// exists under — that is what stops an attacker spreading one guess across
/// thousands of names — and a foreign key would make exactly those rows
/// unwritable. It stores what was typed, after the same lowercase/trim
/// `authorize` applies, so the row keys on what the lookup keyed on.
model LoginAttempt {
  id String @id @default(cuid())

  email String
  // The client address as `clientIp()` derived it, or the literal 'unknown'
  // when no proxy header was present. Never null: a null would need a
  // three-way comparison at every read, and a shared 'unknown' bucket
  // over-throttles rather than under-throttles, which is the right way for
  // this to be wrong.
  ip String
  /// Did this attempt produce a signed-in session? A correct password refused
  /// by the lockout records `false`, because no session was issued and the
  /// evidence should show the full volume of an attack rather than hide the
  /// throttled part of it.
  success Boolean

  createdAt DateTime @default(now())

  // The two throttle reads are `(email, createdAt)` and `(ip, createdAt)`;
  // `createdAt` alone serves the retention prune, which runs on every write
  // and must never degrade into a sequential scan of an attack's worth of rows.
  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}
