# Pooled connection — used by the running application (PgBouncer, many short-lived connections)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/check_monitoring?sslmode=require&channel_binding=require"
DATABASE_URL_TEST="postgresql://user:password@host-pooler.region.aws.neon.tech/check_monitoring_test?sslmode=require&channel_binding=require"

# Direct connection — used by Prisma Migrate only. Migrations take advisory locks,
# which PgBouncer's transaction pooling does not support. Same string without "-pooler".
DIRECT_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/check_monitoring?sslmode=require&channel_binding=require"
DIRECT_DATABASE_URL_TEST="postgresql://user:password@host.region.aws.neon.tech/check_monitoring_test?sslmode=require&channel_binding=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Acumatica OData, read-only. Two tenants on two base URLs, one service account:
# the tenants reuse branch codes for different companies (Go-Live "ST" is Starkson
# Packaging, MANUFACTURING "ST" is Starkson Paper and Plastic), which is why every
# sync states which one it read. Read by lib/integrations/acumatica/from-env.ts.
ACUMATICA_ODATA_URL="https://erp.example.com/GOLIVE/odata"
ACUMATICA_ODATA_URL_MFG="https://erp.example.com/MANUFACTURING/odata"
ACUMATICA_ODATA_USER="service-account"
ACUMATICA_ODATA_PASSWORD="set-in-.env-only"

# The bearer Vercel presents when it calls /api/cron/sync on the daily schedule.
# Generate with `openssl rand -base64 32`. Set in Vercel for Production; the route
# refuses to run at all while it is unset.
CRON_SECRET="generate-with-openssl-rand-base64-32"
