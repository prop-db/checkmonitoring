# Pooled connection — used by the running application (PgBouncer, many short-lived connections)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/check_monitoring?sslmode=require&channel_binding=require"
DATABASE_URL_TEST="postgresql://user:password@host-pooler.region.aws.neon.tech/check_monitoring_test?sslmode=require&channel_binding=require"

# Direct connection — used by Prisma Migrate only. Migrations take advisory locks,
# which PgBouncer's transaction pooling does not support. Same string without "-pooler".
DIRECT_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/check_monitoring?sslmode=require&channel_binding=require"
DIRECT_DATABASE_URL_TEST="postgresql://user:password@host.region.aws.neon.tech/check_monitoring_test?sslmode=require&channel_binding=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
